import assert from 'node:assert/strict';
import {readFile,writeFile} from 'node:fs/promises';
import {resolve,join} from 'node:path';
import {createHash} from 'node:crypto';
import {buildVerifiedTaskArtifact} from '../apps/runtime/src/headless-task-completion.ts';
import {verifyTaskCompletionWire} from '../apps/runtime/src/task-completion-proof.ts';
import {decodeTaskSnapshot} from '../apps/runtime/src/task-state.ts';
import {getAddressDecoder,getProgramDerivedAddress,address,getAddressEncoder} from '@solana/kit';
const directory=resolve(process.argv[2]||'');if(process.argv.length!==3)throw new Error('Provide one evidence directory');
const read=async(name:string)=>JSON.parse(await readFile(join(directory,name),'utf8')),report=await read('report.json'),snapshots=await read('account-snapshots.json'),completion=await read('completion-transaction.json');assert.equal(report.status,'passed');
const transactions=new Map<string,any>();for(let i=0;i<report.input.evidence.length;i++)transactions.set(report.input.evidence[i].signature,await read('action-'+i+'-transaction.json'));
const rpc=async(method:string,params:unknown[])=>{if(method==='getGenesisHash')return report.genesis;if(method==='getAccountInfo'){const snapshot=snapshots[String(params[0])];assert.ok(snapshot,'Archived account missing');return snapshot;}if(method==='getTransaction'){const tx=transactions.get(String(params[0]));assert.ok(tx,'Archived original transaction missing');return tx;}throw new Error('Unexpected offline method '+method);};
const {receipt,input,program,genesis,sessionKey}=report;assert.equal(completion.meta.err,null);assert.ok(completion.meta.fee<=10000);await verifyTaskCompletionWire(program,sessionKey,input,receipt,completion.transaction[0]);
const artifact=await buildVerifiedTaskArtifact({program,genesis,network:input.plan.network,rpc},input,sessionKey,{spentSol:receipt.spentSol,spentUsdc:receipt.spentUsdc});assert.equal(artifact,receipt.artifact);const digest=(s:string)=>createHash('sha256').update(s).digest('hex');assert.equal(digest(artifact),receipt.resultHash);
const data=(k:string)=>{const info=snapshots[k]?.value;assert.ok(info&&!info.executable);assert.equal(info.owner,program);return Buffer.from(info.data[0],'base64');},task=await decodeTaskSnapshot(input.plan.task,data(input.plan.task),program);assert.equal(task.status,'completed');assert.equal(task.resultHash,receipt.resultHash);assert.equal(task.pendingEscrows,'0');assert.equal(task.pendingSkillResults,'0');assert.equal(task.actionCount,'6');assert.equal(task.sol.spent,receipt.spentSol);assert.equal(task.usdc.spent,receipt.spentUsdc);
const [permitKey,bump]=await getProgramDerivedAddress({programAddress:address(program),seeds:[Buffer.from('task_completion'),getAddressEncoder().encode(address(input.plan.task))]}),permit=data(permitKey);assert.equal(permit.length,155);assert.equal(permit[153],1);assert.equal(permit[154],bump);assert.equal(String(getAddressDecoder().decode(permit.subarray(8,40))),input.plan.task);assert.equal(permit.subarray(104,136).toString('hex'),input.plan.planHash);
assert.equal(report.signingRequests,1);assert.deepEqual(report.requests[0],report.requests[1]);assert.equal(report.quotaUnchanged,true);assert.equal(report.completedRestartNoEffects,true);if(report.sharedHandoff){assert.equal(report.sharedServiceRestartRecovered,true);assert.equal(report.freshRuntimeReadWithoutBrowser,true);assert.equal(report.tenantIsolationVerified,true);}const result={status:'passed',offline:true,originalActionProofs:transactions.size,completionWireProof:true,sharedHandoff:report.sharedHandoff?{serviceRestartObserved:true,freshRuntimeObserved:true,tenantIsolationObserved:true}:undefined,canonicalFinalTaskAndPermit:true,artifactBytes:Buffer.byteLength(artifact),resultHash:receipt.resultHash};await writeFile(join(directory,'verification.json'),JSON.stringify(result,null,2)+'\n');console.log(JSON.stringify(result));
