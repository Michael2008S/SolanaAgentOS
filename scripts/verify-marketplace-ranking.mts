for(const item of judgments.filter((item:any)=>item.verdict==='pass')){const owner=agents.get(item.judge)!;if(!judgeOwners.has(owner))judgeOwners.set(owner,[]);judgeOwners.get(owner)!.push(item);}
assert.deepEqual([...judgeOwners.values()].map(items=>items.length).sort((a,b)=>a-b),[1,9]);
const accepted=[...judgments.filter((item:any)=>item.verdict==='fail'),...[...judgeOwners.values()].flatMap(items=>items.sort((a,b)=>b.recordedAt-a.recordedAt||a.escrow.localeCompare(b.escrow)).slice(0,3))];assert.equal(accepted.length,6);assert.deepEqual(new Set(score.evidence.map((item:any)=>item.escrow)),new Set(accepted.map(item=>item.escrow)));
