 assert.equal(key(escrow,8),item.employer);assert.equal(key(escrow,40),item.worker);assert.equal(escrow.readBigUInt64LE(80),1000n);assert.equal(escrow[128],1);assert.equal(escrow[179],0);assert.equal(escrow[161],item.verdict==='pass'?1:2);
 for(const [value,offset,expected] of [[mandate,8,item.escrow],[mandate,40,item.employer],[mandate,72,item.worker],[mandate,104,item.judge],[decision,8,item.escrow],[decision,40,item.mandate],[decision,72,item.judge],[decision,104,key(mandate,136)]] as const)assert.equal(key(value,offset),expected);
 assert.deepEqual(escrow.subarray(96,128),mandate.subarray(168,200));assert.deepEqual(decision.subarray(136,168),mandate.subarray(168,200));assert.deepEqual(decision.subarray(168,200),escrow.subarray(129,161));assert.notEqual(decision.subarray(200,232).toString('hex'),'0'.repeat(64));assert.equal(mandate[216],1);assert.equal(mandate[217],0);assert.equal(mandate[218],1);assert.equal(decision[241],1);assert.equal(decision[232],item.verdict==='pass'?0:1);assert.equal(Number(decision.readBigInt64LE(233)),item.recordedAt);assert.ok(decision.readBigInt64LE(233)>=mandate.readBigInt64LE(208));assert.ok(decision.readBigInt64LE(233)<mandate.readBigInt64LE(200));assert.ok(mandate.readBigInt64LE(200)<=escrow.readBigInt64LE(88));assert.equal(new Set([agents.get(item.worker),agents.get(item.employer),agents.get(item.judge)]).size,3);
}
assert.equal(pages.length,3);assert.deepEqual(pages.map((page:any)=>page.count),[50,50,10]);assert.ok(pages.every((page:any)=>page.evaluatedAt===pages[0].evaluatedAt&&page.genesis===report.genesis&&page.programId===report.programId&&page.commitment==='finalized'&&page.failures.length===0&&page.rankingPolicy.method==='independent-judge-v2'));assert.equal(pages[2].nextCursor,null);
