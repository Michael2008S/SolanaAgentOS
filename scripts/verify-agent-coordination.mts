import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';
import { readFile,writeFile } from 'node:fs/promises';
import { resolve,join } from 'node:path';
import { getTransactionDecoder,getCompiledTransactionMessageDecoder,getBase58Decoder,getPublicKeyFromAddress,verifySignature } from '@solana/kit';
import { parseAutonomousJob } from '../apps/runtime/src/autonomous-loop.ts';
if(process.argv.length!==3)throw new Error('Provide the two-Runtime Agent coordination evidence directory.');
const directory=resolve(process.argv[2]),report=JSON.parse(await readFile(join(directory,'report.json'),'utf8')),sha=(text:string)=>createHash('sha256').update(text).digest('hex');
assert.equal(report.status,'passed');assert.equal(report.runtimePids.length,2);assert.ok(report.runtimePids.every((pid:unknown)=>typeof pid==='number'&&Number.isSafeInteger(pid)&&pid>0));assert.notEqual(report.runtimePids[0],report.runtimePids[1]);
assert.equal(report.totalTransactions,2);assert.equal(report.transactions.length,2);
for(const row of report.transactions){const raw=await readFile(join(directory,row.signature+'.json'),'utf8');assert.equal(sha(raw),row.sha256);const result=JSON.parse(raw).result;assert.equal(result.meta.err,null);assert.equal(result.meta.fee,row.fee);assert.ok(row.fee<=10000);assert.equal(result.slot,row.slot);const tx=getTransactionDecoder().decode(Buffer.from(result.transaction[0],'base64')),message=getCompiledTransactionMessageDecoder().decode(tx.messageBytes);assert.notEqual(message.version,1);if(message.version===1)throw new Error('Unexpected transaction version');assert.equal(getBase58Decoder().decode(tx.signatures[message.staticAccounts[0]]!),row.signature);for(const key of message.staticAccounts.slice(0,message.header.numSignerAccounts))assert.ok(await verifySignature(await getPublicKeyFromAddress(key),tx.signatures[key]!,tx.messageBytes));assert.ok(message.instructions.some(ix=>message.staticAccounts[ix.programAddressIndex]===report.identity.program));}
const first=parseAutonomousJob(report.contention.first),second=parseAutonomousJob(report.contention.second),jobs=report.jobs.map(parseAutonomousJob);
assert.equal(first.state,'planning');assert.equal(first.modelRequests,1);assert.equal(second.state,'planning');assert.equal(second.cycle,0);assert.equal(second.modelRequests,0);assert.notEqual(first.id,second.id);assert.equal(first.agent,second.agent);assert.equal(first.agent,report.identity.agent);assert.equal(first.session,second.session);assert.equal(first.session,report.identity.session);assert.equal(first.genesis,report.identity.genesis);assert.equal(first.program,report.identity.program);assert.equal(report.contention.modelCalls,1);assert.equal(report.contention.reportedFailure,false);
assert.equal(jobs.length,2);for(const [index,job] of jobs.entries()){const original=index===0?first:second;assert.equal(job.id,original.id);assert.equal(job.state,'completed');assert.equal(job.modelRequests,2);assert.equal(job.cycle,1);assert.deepEqual(job.limits,original.limits);assert.equal(job.intents.length,0);assert.deepEqual(job.spent,{sol:'0',usdc:'0'});assert.equal(job.evaluations.length,1);assert.equal(job.evaluations[0].complete,true);}
assert.deepEqual(report.modelCalls.map((call:any)=>[call.goal,call.phase]),[[first.goal,'planning'],[first.goal,'evaluating'],[second.goal,'planning'],[second.goal,'evaluating']]);assert.ok(report.modelCalls.every((call:any)=>call.activeAtDispatch===1));assert.equal(report.modelFixtureRequests,4);assert.equal(report.maximumConcurrentModelCalls,1);assert.equal(report.agentExecutionCounter,'0');assert.equal(report.automaticRetryAfterAgentRelease,true);assert.equal(report.restartWithoutModelReplay,true);assert.equal(report.realModelQuotaUnchanged,true);
const verification={status:'passed',scope:'Offline cryptographic verification of two captured Localnet preparation transactions and recorded two-process scheduling observations; no paid-tool or cross-host acceptance',transactions:2,modelFixtureRequests:4,sharedAgentSerialized:true,contentionDidNotConsumeModelQuota:true,automaticRetryObserved:true,restartWithoutReplay:true};await writeFile(join(directory,'verification.json'),JSON.stringify(verification,null,2)+'\n');console.log(JSON.stringify(verification));
