import assert from 'node:assert/strict';
import { readFile,writeFile } from 'node:fs/promises';
import { resolve,join } from 'node:path';
import { verifyJudgedSettlementWire } from '../apps/runtime/src/judge-settlement-proof.js';
const directory=resolve(process.argv[2]??''),report=JSON.parse(await readFile(join(directory,'report.json'),'utf8'));assert.equal(report.status,'passed');assert.equal(report.settlements.length,4);
const proofs=[];for(const [index,item] of report.settlements.entries()){const tx=JSON.parse(await readFile(join(directory,'settlement-'+index+'-transaction.json'),'utf8'));assert.equal(tx.meta.err,null);assert.ok(Number.isSafeInteger(tx.meta.fee)&&tx.meta.fee>=0&&tx.meta.fee<=10000);await verifyJudgedSettlementWire(report.program,report.employer,report.worker,item.input,item.receipt,tx.transaction[0]);assert.equal(BigInt(item.balanceAfter)-BigInt(item.balanceBefore),BigInt(item.receipt.amount));assert.equal(item.receipt.asset,index<2?'SOL':'USDC');assert.equal(item.receipt.verdict,index%2?'fail':'pass');proofs.push({signature:item.receipt.signature,asset:item.receipt.asset,verdict:item.receipt.verdict,amount:item.receipt.amount,destination:item.receipt.destination,fee:tx.meta.fee});}
assert.equal(report.quotaUnchanged,true);const verification={passed:true,scope:'Captured settlement wires: cryptographic caller signature, exact SOL/USDC instruction/accounts, canonical destination and decision, and metadata fee. Balance changes, finalization, live authority, journal recovery and counters remain online fixture observations; no production Vault or Task completion proof.',proofs,checkedAt:new Date().toISOString()};await writeFile(join(directory,'verification.json'),JSON.stringify(verification,null,2)+'\n');console.log(JSON.stringify(verification));
