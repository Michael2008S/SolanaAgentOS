OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# For DeepSeek use OPENAI_MODEL=deepseek-flash and AGENTOS_MODEL_PROVIDER=deepseek.
# Put its credential in DEEPSEEK_API_KEY. The explicit dev:local:real launcher
# also accepts OPENAI_API_KEY from this same file for existing configurations.
# Real local launches never borrow an ambient OpenAI key for DeepSeek.
AGENTOS_MODEL_PROVIDER=openai
DEEPSEEK_API_KEY=
# Optional shared durable request cap: configure BOTH a limit and a writable path.
# Failed model requests count toward the cap. Per-request output is at most 2,500 tokens.
AGENTOS_MODEL_REQUEST_LIMIT=
AGENTOS_MODEL_BUDGET_PATH=
# Optional owner-only JSONL diagnostics; credential values are redacted.
AGENTOS_MODEL_DIAGNOSTICS_PATH=
AGENTOS_PERSIST_HISTORY=false
AGENTOS_PERSIST_MEMORY=false
AGENTOS_PERSIST_ESCROW_HANDOFFS=false
AGENTOS_PROGRAM_ID=HWwd3RWsmiZ1uo1rd66oj3KaTXggW3B9zNUSFEUCbVzv
SOLANA_RPC_URL=https://api.devnet.solana.com
AGENTOS_WEATHER_SKILL=
AGENTOS_WEATHER_PORT=8788
AGENTOS_NWS_USER_AGENT=AgentOS-Weather-Skill/0.1
AGENTOS_RESEARCH_SKILL=
AGENTOS_RESEARCH_PORT=8789

# Optional local automatic discovery/execution (up to 3 comma-separated Worker Agent addresses).
# Sends verified shared tasks to OpenAI, incurring API charges. No chain signing/delivery.
# Requires employer task handoffs shared with this Runtime; default is disabled.
AGENTOS_WORKER_AUTORUN=

# Exact allowed web origins shared by Runtime and Skill Providers; change for alternate preview ports.
AGENTOS_WEB_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional SQLite persistence for Worker jobs, Escrow handoffs, Memory and planner history; Node.js 24+.
# sqlite makes handoff/Memory persistence mandatory; their PERSIST flags apply only in json mode.
# json preserves the existing file-based behavior. First sqlite use validates/migrates old files.
AGENTOS_STORAGE_BACKEND=json
# Optional public Skill catalog: canonical HTTPS URL, or HTTP loopback for demos.
# See docs/DEMO_RUNBOOK.md section 15. Discovery never invokes or pays services.
AGENTOS_SERVICE_CATALOG_URL=
# Optional federation: JSON array of at most 20 catalog URLs; overrides the single URL.
# Shared Provider directory: https://api.example.com/api/marketplace/services/catalog
# Signed publications and verified bootstrap replicas persist under AGENTOS_DATA_DIR/service-announcements.sqlite.
# Background signed-directory synchronization polls these URLs every minute.
AGENTOS_SERVICE_CATALOG_URLS=
# Separate public Owner-signed Worker profile bootstrap catalogs, at most 20 HTTPS URLs.
# Example: ["https://api.example.com/api/marketplace/profiles/catalog"]
# Verified active canonical profiles replicate durably once per minute. No credentials here.
AGENTOS_WORKER_PROFILE_CATALOG_URLS=
# Absolute path recommended; blank uses apps/runtime/.data/agentos.sqlite.
AGENTOS_DATABASE_PATH=

# Optional authenticated autonomous API; disabled when TENANTS is blank.
# Node.js 24+; see docs/AUTONOMOUS_RUNTIME.md. Never put signing keys here.
AGENTOS_AUTONOMOUS_TENANTS=
# Optional dedicated SQLite access-credential registry; initial hashes seed once.
AGENTOS_TENANT_CREDENTIAL_DATABASE=
AGENTOS_AUTONOMOUS_DATABASE_PATH=
# Operator-controlled protected-wallet execution service, never a model-selected URL.
AGENTOS_EXECUTION_GATEWAY=
AGENTOS_EXECUTION_GATEWAY_TOKEN=
AGENTOS_EXECUTION_FEE_PAYER=
# Built-in background gateway; never run this entry point in watch mode.
# memory: non-exportable process keys; restart requires a new delegation.
# vault-transit: public-key/version-pinned external Ed25519 signer; no file keys.
AGENTOS_HEADLESS_WALLET_MODE=memory
# JSON {feePayer:{endpoint,mount?,key,version,address,tokenEnv,namespace?},tenants:{<tenant>:same}}
# Addresses are PUBLIC. Token env names refer to separate Vault credentials, not keys.
AGENTOS_HEADLESS_VAULT_SIGNERS=
AGENTOS_HEADLESS_TENANTS=
AGENTOS_HEADLESS_TOOLS=
AGENTOS_HEADLESS_PORT=8790
AGENTOS_HEADLESS_JOURNAL_PATH=
# JSON array of {id,endpoint,tools,tokenEnv?}; exact operator-approved remote tools.
# Include mcp:<id>:<tool> in the tenant tools list. Credentials remain in server env.
AGENTOS_EXTERNAL_MCP_SERVERS=
# Fixed paid HTTP tools, configured identically in Runtime and headless gateway.
# [{id:"http:<name>",protocol:"mpp"|"x402",endpoint,recipient,asset:"SOL"|"USDC",amount,description?,method?:"GET"|"POST"}]
# Requires both API and direct-payment permissions in Policy and Session.
# MPP supports SOL/USDC push; x402 supports sponsored classic test USDC.
# x402: fund the Session public key's SOL rent reserve separately. Sponsor pays fees.
# Facilitator must allow AgentOS CPI smart-wallet payments; SDK default rejects them.
# Official @x402/svm requires fee sponsor distinct from recipient owner.
AGENTOS_STANDARD_HTTP_TOOLS=
# Optional owner-approved result notifications. Fixed per-tenant receiver; never model URLs.
# [{"tenant":"owner","endpoint":"https://receiver.example.com/events","secretEnv":"OWNER_NOTIFY_SECRET"}]
# Separate HMAC secret >=32 characters in the named environment variable; never wallet keys.
# POST: stable event id/body; signed headers, at-least-once. Receiver must deduplicate id.
AGENTOS_AUTONOMOUS_NOTIFICATIONS=
# Optional separate public tenant API; existing local preview listener stays loopback.
AGENTOS_PUBLIC_PORT=
AGENTOS_PUBLIC_BIND=127.0.0.1
# Canonical external API origin, e.g. https://api.example.com (no path/query).
AGENTOS_PUBLIC_API_ORIGIN=
# Exact browser origins. No wildcard; API clients without Origin still require Bearer.
AGENTOS_PUBLIC_BROWSER_ORIGINS=[]
# Direct TLS transport credentials. Required for non-loopback binds.
# Leave both empty only for a loopback listener behind an HTTPS reverse proxy.
# These are TLS files, never Solana wallet keys.
AGENTOS_PUBLIC_TLS_CERT=
AGENTOS_PUBLIC_TLS_KEY=

# Optional: evaluation proposes and checkpoints the next plan in one model request.
# Defaults to false; same tool/budget/duplicate/fresh permission guards still apply.
AGENTOS_AUTONOMOUS_COMBINED_EVALUATION=false
