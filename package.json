{
  "name": "agentos",
  "private": true,
  "workspaces": [
    "apps/runtime",
    "apps/web"
  ],
  "scripts": {
    "dev:headless-gateway": "node --import tsx apps/runtime/src/headless-gateway-server.ts",
    "check:local:skill-cache": "node --import tsx tests/local/autonomous-headless-flow.mts --cached-response",
    "check:local:skill-cache:usdc": "node --import tsx tests/local/autonomous-headless-flow.mts --cached-response --usdc",
    "check:local:autonomous": "node --import tsx tests/local/autonomous-headless-flow.mts --run",
    "check:local:vault-restart": "node --import tsx tests/local/autonomous-headless-flow.mts --vault-restart",
    "check:local:standard-payments": "node --import tsx tests/local/standard-payment-flow.mts --run",
    "check:local:mpp-response-recovery": "node --import tsx tests/local/standard-payment-flow.mts --run --interrupt-response-body",
    "check:local:sponsored-payment": "node --import tsx tests/local/sponsored-payment-flow.mts --run",
    "check:local:x402": "node --import tsx tests/local/x402-payment-flow.mts --run",
    "check:local:notifications": "node --import tsx tests/local/autonomous-notification-flow.mts --run",
    "check:public-api": "node --import tsx --test apps/runtime/src/autonomous-public-server.test.ts",
    "accept:real": "node --import tsx scripts/accept-real-model.mts",
    "dev": "concurrently -k -n runtime,web -c cyan,magenta \"npm run dev --workspace=@agentos/runtime\" \"npm run dev --workspace=@agentos/web\"",
    "status:devnet": "node scripts/capture-deployment-status.mjs",
    "preflight:devnet": "node scripts/preflight-devnet.mjs",
    "build:devnet": "node scripts/build-devnet.mjs",
    "evidence:devnet": "node scripts/capture-devnet-evidence.mjs",
    "backup:providers": "node scripts/backup-provider-state.mjs",
    "backup:runtime": "node scripts/backup-runtime-db.mjs",
    "backup:runtime-bundle": "node scripts/backup-runtime-bundle.mjs",
    "verify:runtime-bundle": "node scripts/verify-runtime-bundle.mjs",
    "check:settlement": "cargo test -p agent_os --lib settlement_tests && node --import tsx --test apps/runtime/src/escrow-settlement.test.ts apps/web/src/lib/escrowSettlement.test.ts",
    "dev:runtime": "npm run dev --workspace @agentos/runtime",
    "dev:web": "npm run dev --workspace @agentos/web",
    "dev:weather-provider": "npm run dev:weather-provider --workspace @agentos/runtime",
    "dev:research-provider": "npm run dev:research-provider --workspace @agentos/runtime",
    "dev:local:runtime": "node scripts/local-environment.mjs runtime",
    "dev:local:web": "node scripts/local-environment.mjs web",
    "check:network": "node --import tsx --test shared/chain-network.test.ts",
    "check:local:smoke": "node scripts/check-local-smoke.mjs",
    "check:local:history": "node scripts/check-local-history.mjs",
    "evidence:local:watch": "node scripts/watch-local-receipts.mjs",
    "check:local:units": "node --import tsx --test shared/chain-network.test.ts apps/runtime/src/model-transport.test.ts apps/runtime/src/task-state.test.ts apps/runtime/src/archive-path.test.ts apps/web/src/lib/sessionRecovery.test.ts",
    "check:local:flow": "node --import tsx tests/local/full-flow.mts",
    "check:local:security": "node --import tsx tests/local/security-flow.mts",
    "check:local:memory": "node --import tsx tests/local/memory-flow.mts",
    "check:local:autonomous-worker-tool": "node --import tsx tests/local/worker-tool-autonomous-flow.mts --run",
    "check:local:autonomous-worker-tool:usdc": "node --import tsx tests/local/worker-tool-autonomous-flow.mts --run --usdc",
    "check:local:worker-tool-gateway": "node --import tsx tests/local/worker-tools-flow.mts --gateway",
    "check:local:worker-tool-gateway:usdc": "node --import tsx tests/local/worker-tools-flow.mts --gateway --usdc",
    "check:local:worker-tools": "node --import tsx tests/local/worker-tools-flow.mts",
    "check:local:sqlite": "node --import tsx tests/local/sqlite-backup.mts",
    "check:local:memory:sqlite": "node --import tsx tests/local/memory-flow.mts --sqlite",
    "check:local:worker-tools:usdc": "node --import tsx tests/local/worker-tools-flow.mts --usdc",
    "dev:local:fixture": "node scripts/local-environment.mjs runtime --model-fixture",
    "dev:local:real": "node scripts/local-environment.mjs runtime --real-model",
    "dev:local:real-provider": "node --import tsx scripts/local-real-provider.mts",
    "check:judge:binding": "node --import tsx --test apps/web/src/lib/judgeAutomationBinding.test.ts",
    "check:handoff:recovery": "node --import tsx --test tests/local/escrow-handoff-recovery.test.mts",
    "check:local:automation": "node --import tsx --test apps/web/src/lib/judgeAutomationBinding.test.ts apps/web/src/lib/localWalletDiscovery.test.ts tests/local/escrow-handoff-recovery.test.mts tests/local/model-fixture-hire.test.mts apps/web/src/lib/taskCompletion.test.ts apps/web/src/lib/taskPlan.test.ts apps/web/src/lib/taskCompletionJournal.test.ts apps/web/src/lib/taskRoleProgress.test.ts tests/local/local-launch-options.test.mjs apps/web/src/lib/taskEvidenceSnapshot.test.ts tests/local/local-history.test.mjs",
    "check:local:task-completion": "node --import tsx tests/local/task-completion-flow.mts",
    "check:local:service-announcements": "node --import tsx tests/local/service-announcement-flow.mts --run",
    "accept:real:autonomous": "node --import tsx scripts/accept-real-autonomous.mts",
    "check:local:worker-profile-sync": "node --import tsx tests/local/worker-profile-sync-flow.mts --run",
    "check:local:marketplace-ranking": "node --import tsx tests/local/marketplace-ranking-flow.mts --run",
    "verify:marketplace-ranking": "node --import tsx scripts/verify-marketplace-ranking.mts",
    "check:local:x402-prefunded": "node --import tsx tests/local/x402-prefunded-flow.mts --run",
    "check:local:x402-checkpoint-recovery": "node --import tsx tests/local/x402-prefunded-flow.mts --run --interrupt-checkpoint",
    "check:local:x402-signed-result-recovery": "node --import tsx tests/local/x402-prefunded-flow.mts --run --interrupt-result-broadcast",
    "check:local:x402-missing-result-recovery": "node --import tsx tests/local/x402-prefunded-flow.mts --run --interrupt-result-signing",
    "check:local:x402-response-recovery": "node --import tsx tests/local/x402-prefunded-flow.mts --run --interrupt-response-body",
    "check:local:agent-coordination": "node --import tsx tests/local/autonomous-agent-coordination-flow.mts --run",
    "check:local:runtime-credentials": "node --import tsx tests/local/shared-mcp-recovery-flow.mts --run --remote-coordinator --credential-lifecycle",
    "check:public-credentials": "node --import tsx --test apps/runtime/src/tenant-credentials.test.ts",
    "check:local:action-feedback-loop": "node --import tsx tests/local/shared-mcp-recovery-flow.mts --run --remote-coordinator --action-feedback",
    "check:local:shared-mcp-recovery": "node --import tsx tests/local/shared-mcp-recovery-flow.mts --run",
    "dev:task-coordinator": "node --import tsx apps/runtime/src/autonomous-coordinator-server.ts",
    "check:local:task-coordinator": "node --import tsx tests/local/autonomous-coordinator-flow.mts --run",
    "check:local:central-mcp-recovery": "node --import tsx tests/local/shared-mcp-recovery-flow.mts --run --remote-coordinator",
    "check:local:central-x402-recovery": "node --import tsx tests/local/x402-prefunded-flow.mts --run --interrupt-response-body --remote-coordinator",
    "check:local:mcp-authority-preflight": "node --import tsx tests/local/shared-mcp-recovery-flow.mts --run --remote-coordinator --authority-preflight",
    "check:local:mcp-provider-outage": "node --import tsx tests/local/shared-mcp-recovery-flow.mts --run --remote-coordinator --provider-outage",
    "check:local:worker-delivery": "node --import tsx tests/local/headless-worker-delivery-flow.mts --run",
    "check:local:worker-background-delivery": "node --import tsx tests/local/headless-worker-delivery-flow.mts --run --runtime-queue",
    "check:local:judge-record": "node --import tsx tests/local/headless-judge-record-flow.mts --run",
    "check:local:judge-background-record": "node --import tsx tests/local/headless-judge-record-flow.mts --run --runtime-queue",
    "check:local:judge-settlement": "node --import tsx tests/local/headless-judge-settlement-flow.mts --run",
    "check:local:judge-background-settlement": "node --import tsx tests/local/headless-judge-record-flow.mts --run --runtime-settlement",
    "check:local:headless-task-completion": "node --import tsx tests/local/headless-task-completion-flow.mts --run",
    "dev:shared-handoff": "node --import tsx apps/runtime/src/shared-handoff-server.ts",
    "check:local:shared-task-completion": "node --import tsx tests/local/headless-task-completion-flow.mts --run --shared-handoff",
    "check:local:shared-worker-delivery": "node --import tsx tests/local/headless-worker-delivery-flow.mts --run --runtime-queue --shared-handoff",
    "check:local:background-role-tools": "node --import tsx tests/local/background-role-pipeline-flow.mts --run --tools",
    "check:local:background-role-pipeline": "node --import tsx tests/local/background-role-pipeline-flow.mts --run",
    "check:local:background-role-fail": "node --import tsx tests/local/background-role-pipeline-flow.mts --run --verdict=fail",
    "check:local:background-role-review": "node --import tsx tests/local/background-role-pipeline-flow.mts --run --verdict=needs_review",
    "tenant:credentials": "node --import tsx apps/runtime/src/manage-tenant-credentials.ts",
    "jobs:operator": "node --import tsx apps/runtime/src/manage-autonomous-jobs.ts",
    "check:local:operator-cancellation": "node --import tsx tests/local/shared-mcp-recovery-flow.mts --run --remote-coordinator --operator-cancellation",
    "import:judge-review": "node --import tsx apps/runtime/src/import-judge-review.ts",
    "check:local:background-judge-review": "node --import tsx tests/local/background-role-pipeline-flow.mts --run --manual-review",
    "check:local:worker-tools:background": "node --import tsx tests/local/worker-tools-flow.mts --background",
    "check:local:worker-tools:background:usdc": "node --import tsx tests/local/worker-tools-flow.mts --background --usdc"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "typescript": "^5.9.2"
  }
}
